{
  "name": "noetaris-cogen-frontend-hardened",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "node scripts/check-source.cjs",
    "build": "npm run check && npm run test:transport && npm run test:chat && npm run test:governance && npm run test:knowledge && npm run test:memory && npm run test:research && npm run test:learning && npm run test:claim-review && npm run test:governed && npm run test:queue && npm run test:operations && vite build && npm run test:source-security && npm run check:bundle",
    "preview": "vite preview --host 0.0.0.0",
    "check:bundle": "node scripts/validate-pages.cjs",
    "audit:pages": "node scripts/audit-pages.mjs",
    "test:source-security": "node --test scripts/source-security.test.js",
    "test:transport": "node --test scripts/live-transport.test.js",
    "test:chat": "node --test scripts/live-chat.test.js",
    "test:governance": "node --test scripts/live-governance.test.js",
    "test:knowledge": "node --test scripts/live-knowledge.test.js",
    "test:memory": "node --test scripts/live-memory.test.js",
    "test:research": "node --test scripts/live-research.test.js",
    "test:learning": "node --test scripts/live-learning.test.js",
    "test:claim-review": "node --test scripts/live-claim-review.test.js",
    "test:governed": "node --test scripts/live-governed.test.js",
    "test:queue": "node --test scripts/live-queue.test.js",
    "test:operations": "node --test scripts/live-operations.test.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.8",
    "@react-three/fiber": "^9.1.2",
    "@tanstack/react-query": "^5.83.0",
    "@xyflow/react": "^12.8.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "sonner": "^2.0.6",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.57.0",
    "vite": "^6.3.5",
    "postcss": "^8.5.6",
    "typescript": "^5.9.2",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.21"
  },
  "overrides": {
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
