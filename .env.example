# Local defaults only. Do not publish the API directly without TLS, authentication and rate limits.
NSAI_HOST_PORT=8787
NSAI_MODEL_URL=
NSAI_MODEL_NAME=google/gemma-3-1b-it
NSAI_MODEL_API_KEY_FILE=
NSAI_MAX_INPUT_CHARS=20000
# AMD override deployment (configure only after checking GPU instance + compatibility)
NSAI_VLLM_IMAGE=vllm/vllm-openai-rocm:v0.31.0
NSAI_VLLM_MODEL=
NSAI_GPU_RENDER_DEVICE=/dev/dri/renderD128

# Local Ollama profile (CPU by default, no AMD required)
NSAI_LOCAL_MODEL=gemma3:1b
NSAI_OLLAMA_IMAGE=ollama/ollama:latest

# CPU-only llama.cpp profile: set a validated GGUF file and exact digest; weights are not bundled.
NSAI_GGUF_PATH=
NSAI_GGUF_SHA256=
NSAI_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server@sha256:89f180f16f295ee496fe00924ec2118cae2efec519d1a82c605420af09d2a6df
