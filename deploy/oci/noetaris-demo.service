[Unit]
Description=Noetaris Oracle hackathon backend
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/noetaris
ExecStart=/usr/bin/docker compose -f /opt/noetaris/compose.json up -d --wait
ExecStop=/usr/bin/docker compose -f /opt/noetaris/compose.json stop
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
