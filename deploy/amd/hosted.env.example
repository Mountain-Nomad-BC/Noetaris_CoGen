# Owner-selected hosted AMD primary; no owned ROCm instance/credits required.
# Configuration intent only. Source-bearing dispatch still requires qualified
# export authorization, tokenizer admission and durable provider accounting.
NSAI_MODEL_URL=https://developer.amd.com.cn/radeon/api/v1
NSAI_MODEL_NAME=Gemma-4-31B-IT
NSAI_MODEL_PROVIDER=amd-hosted
NSAI_MODEL_FUNDING=free
NSAI_MODEL_API_KEY_FILE=/run/secrets/amd_api_key
# Candidate policy order: AMD, OpenRouter 31B :free, OpenRouter 26B :free, CPU.
# Never substitute priced/unsuffixed OpenRouter model IDs.
